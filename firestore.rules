rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // Core Global Primitives & Helper Functions
    // =========================================================

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return isAuthenticated();
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasUserDoc() {
      return isAuthenticated() && exists(/databases/{database}/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/{database}/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        // 1. Firebase Custom Claims
        (request.auth.token != null && (
          ('role' in request.auth.token && request.auth.token.role in ['super_admin', 'platform_super_admin']) ||
          ('isSuperAdmin' in request.auth.token && request.auth.token.isSuperAdmin == true) ||
          ('admin' in request.auth.token && request.auth.token.admin == true)
        )) ||
        // 2. Sovereign Executive Emails & Official Domains
        (request.auth.token.email != null && (
          request.auth.token.email.matches('(?i)^fetkofficial@gmail\\.com$') ||
          request.auth.token.email.matches('(?i)^admin@fetindia\\.com$') ||
          request.auth.token.email.matches('(?i)^admin@fetindia\\.org$') ||
          request.auth.token.email.matches('(?i)^superadmin@fetindia\\.com$') ||
          request.auth.token.email.matches('(?i)^superadmin@fetindia\\.org$') ||
          request.auth.token.email.matches('(?i).*superadmin.*@fetindia\\.(com|org)$') ||
          request.auth.token.email.matches('(?i).*admin.*@fetindia\\.(com|org)$')
        )) ||
        // 3. User document roles & primaryRole with safe property access
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'platform_super_admin'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'platform_super_admin']) ||
          ('role' in getUserData() && getUserData().role in ['super_admin', 'platform_super_admin']) ||
          ('email' in getUserData() && (
            getUserData().email.matches('(?i)^fetkofficial@gmail\\.com$') ||
            getUserData().email.matches('(?i).*superadmin.*@fetindia\\.(com|org)$') ||
            getUserData().email.matches('(?i).*admin.*@fetindia\\.(com|org)$')
          ))
        ))
      );
    }

    function hasAdminRole() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny([
            'super_admin', 'administrator', 'core_member', 'volunteer_admin', 'member_admin', 'donor_admin',
            'crowdfunding_admin', 'examination_admin', 'exam_admin', 'exam_controller', 'school_admin',
            'madrasa_admin', 'finance_admin', 'hr_admin', 'content_admin', 'blog_admin',
            'store_admin', 'travel_admin', 'reports_admin',
            'district_admin', 'district_crowdfunding_admin', 'district_exam_admin',
            'state_admin', 'state_crowdfunding_admin', 'state_exam_admin',
            'national_admin', 'national_crowdfunding_admin', 'national_exam_admin'
          ])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'exam_controller', 'exam_admin', 'examination_admin']) ||
          ('role' in getUserData() && getUserData().role in ['super_admin', 'administrator', 'exam_controller', 'exam_admin', 'examination_admin'])
        ))
      );
    }

    function canPublishContent() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        hasAdminRole() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny([
            'super_admin', 'administrator', 'blog_admin', 'content_admin'
          ])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in [
            'super_admin', 'administrator', 'blog_admin', 'content_admin'
          ]) ||
          ('role' in getUserData() && getUserData().role in [
            'super_admin', 'administrator', 'blog_admin', 'content_admin'
          ]) ||
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny([
            'blog.publish', 'blog.create', 'blog.edit', 'press.publish', 'news.publish', 'news.edit',
            'trust.publish', 'trust.edit', 'bulletin.publish', 'bulletin.edit', 'content.publish', 'settings.manage'
          ])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny([
            'blog.publish', 'blog.create', 'blog.edit', 'press.publish', 'news.publish', 'news.edit',
            'trust.publish', 'trust.edit', 'bulletin.publish', 'bulletin.edit', 'content.publish', 'settings.manage'
          ]))
        ))
      );
    }

    function canManageTrustContent() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny([
            'super_admin', 'administrator', 'content_admin'
          ])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in [
            'super_admin', 'administrator', 'content_admin'
          ]) ||
          ('role' in getUserData() && getUserData().role in [
            'super_admin', 'administrator', 'content_admin'
          ]) ||
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny([
            'trust.publish', 'trust.edit', 'content.publish', 'settings.manage'
          ])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny([
            'trust.publish', 'trust.edit', 'content.publish', 'settings.manage'
          ]))
        ))
      );
    }

    function canReviewCases() {
      return isAuthenticated() && (
        hasAdminRole() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny([
            'district_admin', 'district_crowdfunding_admin',
            'state_admin', 'state_crowdfunding_admin',
            'national_admin', 'national_crowdfunding_admin',
            'crowdfunding_admin'
          ])) ||
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny([
            'cases.district_review', 'cases.state_review', 'cases.national_review',
            'cases.recommend', 'cases.clarify', 'donors.manage'
          ])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny([
            'cases.district_review', 'cases.state_review', 'cases.national_review',
            'cases.recommend', 'cases.clarify', 'donors.manage'
          ]))
        ))
      );
    }

    function canManageFinance() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny([
            'super_admin', 'administrator', 'finance_admin'
          ])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in [
            'super_admin', 'administrator', 'finance_admin'
          ]) ||
          ('role' in getUserData() && getUserData().role in [
            'super_admin', 'administrator', 'finance_admin'
          ]) ||
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny([
            'finance.manage', 'finance.view', 'finance.income', 'finance.expense',
            'finance.ledger', 'finance.budget', 'finance.accounts', 'finance.reconciliation',
            'finance.reports', 'finance.approve'
          ])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny([
            'finance.manage', 'finance.view', 'finance.income', 'finance.expense',
            'finance.ledger', 'finance.budget', 'finance.accounts', 'finance.reconciliation',
            'finance.reports', 'finance.approve'
          ]))
        ))
      );
    }

    function canManageRoles() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator'])) ||
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny(['roles.manage', 'admin.delegation'])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny(['roles.manage', 'admin.delegation'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator'])
        ))
      );
    }

    function canViewUsers() {
      return isAuthenticated() && (
        hasAdminRole() ||
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('permissions' in getUserData() && getUserData().permissions is list && getUserData().permissions.hasAny(['users.view', 'roles.manage'])) ||
          ('customPermissions' in getUserData() && getUserData().customPermissions is list && getUserData().customPermissions.hasAny(['users.view', 'roles.manage']))
        ))
      );
    }

    // =========================================================
    // Organization Configuration & Dynamic CMS
    // =========================================================
    match /organization_config/{configId} {
      allow read: if true; // Public site branding, colors, and tagline
      allow write: if isSuperAdmin() || canManageTrustContent();
    }

    // =========================================================
    // Public Accreditation & Verification Records (Non-sensitive)
    // =========================================================
    match /public_memberships/{memberId} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasAdminRole();
    }

    match /public_donors/{donorId} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasAdminRole();
    }

    match /public_volunteers/{volunteerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasAdminRole();
    }

    match /public_staff/{staffId} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasAdminRole();
    }

    match /public_certificates/{certId} {
      allow read: if true;
      allow write: if isSuperAdmin() || hasAdminRole();
    }

    // =========================================================
    // User Profiles & Identity Collection
    // =========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || canViewUsers());
      allow create: if isAuthenticated() && request.auth.uid == userId && (request.resource.data.uid == userId);
      allow update: if isAuthenticated() && (
        // Normal users updating own profile cannot touch roles, permissions, or administrative status
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'roles', 'primaryRole', 'role', 'accountType', 'permissions', 'customPermissions', 
          'status', 'accountStatus', 'uid', 'email',
          'membershipStatus', 'volunteerStatus', 'donorStatus',
          'membershipId', 'volunteerId', 'donorId',
          'promotedAt', 'promotedBy', 'promotedByEmail', 'promotionNote',
          'delegatedScopes', 'activeScopeLevel', 'assignedState', 'assignedDistricts'
        ])) ||
        // Role managers and Super Admins can update roles/permissions/status
        isSuperAdmin() ||
        canManageRoles()
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Module Matrix
    // =========================================================
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // =========================================================
    // System Audit Logs (Append-only)
    // =========================================================
    match /audit_logs/{logId} {
      allow read: if hasAdminRole();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable
    }

    // =========================================================
    // Sequence Counters
    // =========================================================
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminRole() || isSuperAdmin();
    }

    // =========================================================
    // Notifications & Broadcasts Subsystem
    // =========================================================
    match /notifications/{notificationId} {
      allow read: if resource.data.targetAudience == 'all' ||
                     (isAuthenticated() && (hasAdminRole() || (resource.data.targetUserIds != null && resource.data.targetUserIds.hasAny([request.auth.uid]))));
      allow write: if hasAdminRole();
    }

    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        hasAdminRole()
      );
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'userId', 'userEmail', 'title', 'message', 'createdAt', 'type', 'module', 'createdBy', 'broadcastId', 'targetGroup'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    match /admin_broadcasts/{broadcastId} {
      allow read: if hasAdminRole();
      allow create: if hasAdminRole();
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================
    // Membership Applications
    // =========================================================
    match /membershipApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.applicantUid == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.applicantUid == request.auth.uid &&
        (request.resource.data.status == 'pending' || !('status' in request.resource.data));
      allow update: if isAuthenticated() && (
        (resource.data.applicantUid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.applicantUid == resource.data.applicantUid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'approvedBy', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'reviewNotes', 'applicantUid'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Volunteer Applications & Activities
    // =========================================================
    match /volunteerApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.applicantUid == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.applicantUid == request.auth.uid &&
        (request.resource.data.status == 'pending' || !('status' in request.resource.data));
      allow update: if isAuthenticated() && (
        (resource.data.applicantUid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.applicantUid == resource.data.applicantUid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'approvedBy', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'reviewNotes', 'applicantUid'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isSuperAdmin();
    }

    match /volunteer_categories/{categoryId} {
      allow read: if true;
      allow write: if hasAdminRole();
    }

    match /volunteer_activities/{activityId} {
      allow read: if isAuthenticated();
      allow create, delete: if hasAdminRole();
      allow update: if isAuthenticated() && (
        hasAdminRole() || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledVolunteerIds', 'updatedAt'])
      );
    }

    match /volunteer_history/{historyId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.volunteerUid == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.volunteerUid == request.auth.uid ||
        hasAdminRole()
      );
      allow update: if hasAdminRole();
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Donor Applications & Community Groups
    // =========================================================
    match /donorApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.applicantUid == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.applicantUid == request.auth.uid &&
        (request.resource.data.status == 'pending' || !('status' in request.resource.data));
      allow update: if isAuthenticated() && (
        (resource.data.applicantUid == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.applicantUid == resource.data.applicantUid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'approvedBy', 'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'reviewNotes', 'applicantUid'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isSuperAdmin();
    }

    match /community_groups/{groupId} {
      allow read: if isAuthenticated();
      allow write: if hasAdminRole();
    }

    // =========================================================
    // Crowdfunding Campaigns & Verified Contributions
    // =========================================================
    match /crowdfunding_campaigns/{campaignId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.creatorUid == request.auth.uid &&
        (request.resource.data.status in ['pending_review', 'draft']) &&
        (request.resource.data.raisedAmount == 0 || !('raisedAmount' in request.resource.data)) &&
        (request.resource.data.verifiedDonationsCount == 0 || !('verifiedDonationsCount' in request.resource.data));
      allow update: if isAuthenticated() && (
        (resource.data.creatorUid == request.auth.uid &&
         (resource.data.status in ['pending_review', 'draft']) &&
         request.resource.data.creatorUid == resource.data.creatorUid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'status', 'approvedByUid', 'approvedByEmail', 'approvedAt', 
           'reviewedByUid', 'reviewedByEmail', 'reviewedAt', 'reviewNotes', 
           'rejectionReason', 'raisedAmount', 'verifiedDonationsCount', 'creatorUid'
         ])) ||
        hasAdminRole() ||
        canReviewCases()
      );
      allow delete: if isSuperAdmin();
    }

    match /campaign_donations/{donationId} {
      allow read: if true;
      allow create: if (
        request.resource.data.paymentStatus in ['pending_verification', 'initiated'] ||
        (hasAdminRole() && request.resource.data.paymentStatus == 'verified')
      );
      allow update: if (
        hasAdminRole() ||
        (
          resource.data.paymentStatus in ['initiated', 'pending_verification'] &&
          request.resource.data.paymentStatus in ['verified', 'failed', 'cancelled'] &&
          request.resource.data.transactionReference is string
        )
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Financial Records & Foundation Accounting Subsystem (Chapter 15 SRS)
    // =========================================================
    match /financial_records/{recordId} {
      allow read: if isAuthenticated() && (
        canManageFinance() ||
        hasAdminRole() ||
        (resource != null && (
          resource.data.donorUid == request.auth.uid ||
          (request.auth.token.email != null && resource.data.payerPayeeEmail == request.auth.token.email)
        ))
      );
      allow create, update: if isAuthenticated() && (canManageFinance() || hasAdminRole());
      allow delete: if isSuperAdmin();
    }

    match /finance_accounts/{accountId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create, update: if isAuthenticated() && canManageFinance();
      allow delete: if isSuperAdmin();
    }

    match /finance_bank_accounts/{accountId} {
      allow read: if isAuthenticated() && (canManageFinance() || hasAdminRole());
      allow create, update: if isAuthenticated() && (canManageFinance() || hasAdminRole());
      allow delete: if isSuperAdmin();
    }

    match /finance_ledgers/{entryId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create: if isAuthenticated() && canManageFinance();
      allow update: if isSuperAdmin(); // Immutability: adjustments preferred over mutation
      allow delete: if false; // General Ledgers are strictly immutable audit records
    }

    match /finance_budgets/{budgetId} {
      allow read: if isAuthenticated() && (
        canManageFinance() ||
        hasAdminRole() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['core_member', 'finance_admin', 'administrator', 'super_admin'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['core_member', 'finance_admin', 'administrator', 'super_admin'])
        ))
      );
      allow create, update: if isAuthenticated() && (canManageFinance() || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /finance_vouchers/{voucherId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create, update: if isAuthenticated() && canManageFinance();
      allow delete: if isSuperAdmin();
    }

    match /finance_grants/{grantId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create, update: if isAuthenticated() && canManageFinance();
      allow delete: if isSuperAdmin();
    }

    match /finance_assets/{assetId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create, update: if isAuthenticated() && canManageFinance();
      allow delete: if isSuperAdmin();
    }

    match /finance_reconciliations/{recId} {
      allow read: if isAuthenticated() && canManageFinance();
      allow create, update: if isAuthenticated() && canManageFinance();
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Institutional Fee Management Subsystem (Chapter 15.10 SRS - Task 6)
    // =========================================================
    match /student_fees/{feeId} {
      allow read: if isAuthenticated() && (
        canManageFinance() ||
        hasAdminRole() ||
        (resource != null && resource.data.studentUid == request.auth.uid) ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['school_admin', 'madrasa_admin', 'core_member'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['school_admin', 'madrasa_admin', 'core_member'])
        ))
      );
      allow create: if isAuthenticated() && (
        canManageFinance() ||
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['school_admin', 'madrasa_admin', 'administrator', 'super_admin'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['school_admin', 'madrasa_admin', 'administrator', 'super_admin'])
        ))
      );
      allow update: if isAuthenticated() && (
        canManageFinance() ||
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['school_admin', 'madrasa_admin', 'administrator', 'super_admin'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['school_admin', 'madrasa_admin', 'administrator', 'super_admin'])
        )) ||
        (resource != null && resource.data.studentUid == request.auth.uid)
      );
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // External Platform Integration Subsystem (Task 7)
    // =========================================================
    match /integration_platforms/{platformId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /integration_sso_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.userUid == request.auth.uid) ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================
    // FET Store Subsystem (Products & Categories Foundation)
    // =========================================================
    match /store_products/{productId} {
      allow read: if (resource != null && resource.data.isPublished == true) ||
                     (isAuthenticated() && (
                       isSuperAdmin() ||
                       (hasUserDoc() && (
                         ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
                         ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
                       ))
                     ));
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
        ))
      );
      allow delete: if isSuperAdmin();
    }

    match /store_categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (
        isSuperAdmin() ||
        (hasUserDoc() && (
          ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
          ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
        ))
      );
      allow delete: if isSuperAdmin();
    }

    match /store_orders/{orderId} {
      // 1. Read: The authenticated customer can read their own orders; Super Admin and Store Managers can read all orders;
      // and get is permitted for draft/pending/processing/paid orders or non-existent document checks during validation
      allow get: if (
        (isAuthenticated() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          isSuperAdmin() ||
          (hasUserDoc() && (
            ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
            ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
          ))
        )) ||
        resource == null ||
        (resource.data.orderStatus in ['draft', 'pending_payment', 'processing', 'paid', 'completed'])
      );
      allow list: if (
        (isAuthenticated() && (
          (resource != null && resource.data.userId == request.auth.uid) ||
          isSuperAdmin() ||
          (hasUserDoc() && (
            ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
            ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
          ))
        )) ||
        (resource != null && (resource.data.orderStatus in ['draft', 'pending_payment', 'processing', 'paid', 'completed']))
      );

      // 2. Create: Authenticated users can create draft/pending/processing/completed orders bound to their own uid; admins can create desk orders;
      // or authoritative server-validated drafts in draft/pending/processing/completed status with valid customer identity
      allow create: if (
        (isAuthenticated() && (
          (incoming().userId == request.auth.uid) ||
          isSuperAdmin() ||
          (hasUserDoc() && (
            ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
            ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
          ))
        )) ||
        (
          incoming().orderStatus in ['draft', 'pending_payment', 'processing', 'completed'] &&
          incoming().paymentStatus in ['unpaid', 'pending', 'paid', 'captured', 'free'] &&
          incoming().authoritativeValidationCompleted == true &&
          incoming().userId is string && incoming().userId.size() > 0 &&
          incoming().customer.email is string && incoming().customer.email.size() > 0 &&
          incoming().customer.fullName is string && incoming().customer.fullName.size() > 0
        )
      );

      // 3. Update: Customers can update notes or cancel their own draft/pending orders; Store Managers and Super Admins can update status/fulfillment;
      // and updating notes on draft orders while in draft status preserving customer userId and total
      allow update: if (
        (isAuthenticated() && (
          (resource != null && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid) ||
          isSuperAdmin() ||
          (hasUserDoc() && (
            ('roles' in getUserData() && getUserData().roles is list && getUserData().roles.hasAny(['super_admin', 'administrator', 'store_admin', 'store_manager'])) ||
            ('primaryRole' in getUserData() && getUserData().primaryRole in ['super_admin', 'administrator', 'store_admin', 'store_manager'])
          ))
        )) ||
        (
          resource != null &&
          resource.data.orderStatus in ['draft', 'pending_payment', 'processing', 'paid', 'completed'] &&
          incoming().userId == resource.data.userId &&
          incoming().total == resource.data.total &&
          incoming().orderStatus in ['draft', 'pending_payment', 'processing', 'paid', 'completed']
        )
      );

      // 4. Delete: Strictly prohibited to maintain audit trails and preserve historical financial/order records
      allow delete: if false;
    }

    // =========================================================
    // Competitions & Examinations Subsystem
    // =========================================================
    match /competitions/{competitionId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && hasAdminRole();
      allow delete: if isSuperAdmin();
    }

    match /competition_registrations/{registrationId} {
      allow read: if (
        (resource != null && resource.data.isResultPublished == true) ||
        (isAuthenticated() && (
          (resource != null && (
            resource.data.participantUid == request.auth.uid ||
            resource.data.userId == request.auth.uid ||
            resource.data.candidateUid == request.auth.uid ||
            resource.data.uid == request.auth.uid
          )) ||
          hasAdminRole()
        ))
      );
      allow create: if isAuthenticated() && (
        request.resource.data.participantUid == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        hasAdminRole()
      );
      allow update: if isAuthenticated() && (
        (((resource.data.participantUid == request.auth.uid) || (resource.data.userId == request.auth.uid)) &&
         !resource.data.isResultPublished == true &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'marksObtained', 'totalMarks', 'percentage', 'grade', 'rank', 'awardCategory',
           'isResultPublished', 'evaluatedByUid', 'evaluatedByEmail', 'evaluatedAt',
           'certificateIssued', 'certificateId', 'participantUid', 'competitionId'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isSuperAdmin();
    }

    match /question_banks/{bankId} {
      allow read: if isAuthenticated() && hasAdminRole();
      allow create, update: if isAuthenticated() && hasAdminRole();
      allow delete: if isSuperAdmin();
    }

    match /exam_papers/{paperId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && hasAdminRole();
      allow delete: if isSuperAdmin();
    }

    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.participantUid == request.auth.uid) ||
        hasAdminRole()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.participantUid == request.auth.uid ||
        hasAdminRole()
      );
      allow update: if isAuthenticated() && (
        (resource.data.participantUid == request.auth.uid &&
         resource.data.status == 'in_progress' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'autoScore', 'manualScore', 'finalScore', 'participantUid', 'competitionId'
         ])) ||
        hasAdminRole()
      );
      allow delete: if isSuperAdmin();
    }

    match /competition_certificates/{certId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && hasAdminRole();
      allow delete: if isSuperAdmin();
    }

    // =========================================================
    // Trust News, Circulars, Blogs & Media Releases
    // =========================================================
    match /news/{newsId} {
      allow read: if true;
      allow create, update: if canPublishContent();
      allow delete: if isSuperAdmin() || canPublishContent();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create, update: if canPublishContent();
      allow delete: if isSuperAdmin() || canPublishContent();
    }

    match /bulletins/{bulletinId} {
      allow read: if true;
      allow create, update: if canPublishContent();
      allow delete: if isSuperAdmin() || canPublishContent();
    }

    match /trust_content/{contentId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() || canManageTrustContent();
      allow delete: if isSuperAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAuthenticated() && (hasAdminRole() || canReviewCases());
    }

    // Global default catch-all fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

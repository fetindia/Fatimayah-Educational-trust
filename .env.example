# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Optional dedicated production backend API URL (e.g., https://fet-india-api-xxxx.a.run.app).
# If left empty, API requests use same-origin relative paths (/api/*), compatible with Firebase Hosting rewrites.
VITE_API_BASE_URL=""

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (FET India Merchant Account)
# Razorpay Key ID (Public key: rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
# Razorpay Key Secret (Server-side ONLY - strictly confidential)
RAZORPAY_KEY_SECRET="your_razorpay_secret_here"
# Razorpay Webhook Secret (Configured in Razorpay Merchant Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

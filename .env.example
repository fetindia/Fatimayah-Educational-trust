# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Optional dedicated production backend API URL (e.g., https://fet-india-api-xxxx.a.run.app).
# If left empty, API requests use same-origin relative paths (/api/*), compatible with Firebase Hosting rewrites.
VITE_API_BASE_URL=""

# RAZORPAY PAYMENT GATEWAY CREDENTIALS (FET India Merchant Account)
# Razorpay Key ID (Obtained from Razorpay Merchant Dashboard -> API Keys & Webhooks)
RAZORPAY_KEY_ID=
# Razorpay Key Secret (Server-side ONLY - strictly confidential)
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret (Configured in Razorpay Merchant Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# BREVO (SENDINBLUE) EMAIL API CONFIGURATION (FET Store Transactional Email Notifications)
# Brevo API Key (Obtained from Brevo Dashboard -> SMTP & API -> API Keys)
BREVO_API_KEY=
# Brevo Sender Email (Must be an authorized sender domain in Brevo, defaults to store@fetindia.org)
BREVO_SENDER_EMAIL=store@fetindia.org
